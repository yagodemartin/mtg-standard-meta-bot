# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=tu_token_aqui

# ID del rol que puede usar los comandos de compilación
ALLOWED_ROLE_ID=id_del_rol_permitido

# ID del servidor de Discord
GUILD_ID=id_del_servidor

# ID de la aplicación del bot
CLIENT_ID=id_del_bot

# Timeout en milisegundos para la ejecución (default: 10000 = 10 segundos)
TIMEOUT_MS=10000
